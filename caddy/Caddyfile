# HTTPS for Batter with Caddy's own local certificate authority.
# Certificates are issued on demand for whatever name or IP the box is opened
# by (LAN IP, NetBird IP or DNS name), so nothing needs configuring. Browsers
# warn until the root certificate (served at /ca.crt) is trusted once.
{
	on_demand_tls {
		ask http://127.0.0.1:5555/allow
	}
}

# Permission check for on-demand certificates: hostname- or IP-shaped names
# only. Bound to localhost, used by Caddy itself.
http://127.0.0.1:5555 {
	bind 127.0.0.1
	@name expression `{query.domain}.matches("^[A-Za-z0-9.:-]{1,253}$")`
	respond @name 200
	respond 403
}

https:// {
	tls internal {
		on_demand
	}

	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	# The API and WebSockets (live video) go straight to the Go backend;
	# routing them through the Next.js server's proxy cost a hop per frame.
	@backend path /api/* /ws/*
	handle @backend {
		reverse_proxy 127.0.0.1:{$BATTER_API_PORT:8080}
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

http:// {
	redir https://{host}{uri} permanent
}
