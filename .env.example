# =============================================================================
# Batter Configuration
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Then generate a JWT secret:
#   openssl rand -hex 32
# =============================================================================

# REQUIRED: Secret for signing JWT tokens (generate with: openssl rand -hex 32)
JWT_SECRET=

# Database credentials (change in production)
POSTGRES_USER=batter
POSTGRES_PASSWORD=batter
POSTGRES_DB=batter

# Port the app is accessible on (default: 3000)
# BATTER_PORT=3000

# If accessing Batter from a different host/port, set these:
# ALLOWED_ORIGINS=http://192.168.1.100:3000
# FRONTEND_URL=http://192.168.1.100:3000

# -----------------------------------------------------------------------------
# Advanced (optional) — backend reads these directly; defaults shown.
# In Docker Compose these are wired for you; override only if you know you need to.
# -----------------------------------------------------------------------------
# Backend bind host/port (the Go API, behind the frontend proxy):
# HOST=0.0.0.0
# PORT=8080
#
# Postgres connection string. Compose builds this from POSTGRES_* above;
# set it explicitly only when pointing at an external database:
# DATABASE_URL=postgres://batter:batter@postgres:5432/batter?sslmode=disable
#
# Access-token lifetime in seconds (default: 3600 = 1 hour):
# JWT_EXPIRY_SECS=3600
#
# scrcpy server binary + version the backend pushes to devices:
# SCRCPY_SERVER_PATH=/usr/local/share/scrcpy/scrcpy-server
# SCRCPY_VERSION=3.3.4
#
# Directory for runtime data (screenshot cache, etc.):
# DATA_DIR=./data
