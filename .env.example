# =============================================================================
# Batter — optional settings
# =============================================================================
# Nothing here is required. `docker compose up -d` works with no .env file:
#   - the login-token secret is generated on first start and kept in the
#     batter_data volume
#   - the UI and API only accept requests from the host you open Batter on
#   - the database is only reachable inside the compose network
#
# Copy to .env and uncomment only what you need to change:
#   cp .env.example .env
# =============================================================================

# Batter is served over HTTPS on ports 443/80 by the built-in caddy service.
# The app's plain-HTTP port is local-only by default; expose it only if you
# know you need it (live video won't work over plain HTTP except on localhost):
# BATTER_PORT=127.0.0.1:3000

# Log level: debug, info, warn, error (default: info).
# LOG_LEVEL=info

# Proxies whose X-Forwarded-For is believed (default: the in-container hop,
# which carries the real client IP set by caddy). Rarely needs changing.
# TRUSTED_PROXIES=127.0.0.1,::1

# Only if the UI is served from a different origin than the API:
# ALLOWED_ORIGINS=https://batter.example.com

# Fixed login-token secret (default: generated and stored in the data volume).
# Changing it logs everyone out.
# JWT_SECRET=

# Database credentials (default: batter/batter/batter, internal network only).
# Set these BEFORE the first start; changing them later needs a manual
# password change inside Postgres.
# POSTGRES_USER=batter
# POSTGRES_PASSWORD=batter
# POSTGRES_DB=batter

# -----------------------------------------------------------------------------
# Running the backend outside Docker (development) — defaults shown:
# HOST=0.0.0.0
# PORT=8080
# DATABASE_URL=postgres://batter:batter@localhost:5432/batter?sslmode=disable
# DATA_DIR=./data
# JWT_EXPIRY_SECS=3600
# SCRCPY_SERVER_PATH=/usr/local/share/scrcpy/scrcpy-server
# SCRCPY_VERSION=3.3.4
